;; The CNI source catalog, as Kotoba.
;;
;; GENERATED by scripts/gen-kotoba-port.cljk from data/datascript-tx.edn.
;; So is the Clojure reading in src/association/facts.kotoba. The facts
;; are authored once, in the data file, and nowhere else; this one also
;; reaches the Kotoba oracle, wasm and both native ISAs. Do not hand-edit
;; either -- run the generator, and `--check` will tell you if someone did.
;;
;; `:topic` is a SET in the Clojure reading. A set has no order and `topic`
;; is indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; The parity suite that used to compare these two files does not run in
;; this repository -- see the generator's header. `--check` replaces it:
;; both readings are regenerated and compared to what is on disk.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "cni"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 30 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 30)) false))

(defn entry-field-0 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "cni.self-description")
    (string=? f "title") (option-some-of [:option :string] "CNI describes itself as the principal representative of Brazil's industrial sector, pursuing its promotion and efficiency")
    (string=? f "association") (option-some-of [:option :string] "cni")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "BRA")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://cni.portaldaindustria.com.br/pt/institucional")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-cni-portaldaindustria")
    (string=? f "source-article") (option-some-of [:option :string] "Institucional")
    (string=? f "source-quote") (option-some-of [:option :string] "Somos a Confederação Nacional da Indústria (CNI), principal representante do setor industrial do Brasil, em busca da sua promoção e eficiência.")
    (string=? f "date-unknown-because") (option-some-of [:option :string] "page-states-a-standing-arrangement")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-24")
    :else (option-none-of [:option :string])))

