(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "compliance") 1
      (string=? candidate "constitution") 3
      (string=? candidate "governance") 20
      (string=? candidate "history") 8
      (string=? candidate "international") 2
      (string=? candidate "labor") 5
      (string=? candidate "membership") 5
      (string=? candidate "policy") 3
      (string=? candidate "statute") 13
      :else 0)
    0))

