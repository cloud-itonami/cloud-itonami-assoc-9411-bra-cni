(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (entry-field-0 f)
      (= i 1) (entry-field-1 f)
      (= i 2) (entry-field-2 f)
      (= i 3) (entry-field-3 f)
      (= i 4) (entry-field-4 f)
